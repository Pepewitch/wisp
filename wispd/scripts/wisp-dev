#!/bin/sh
set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/../.." && pwd -P)
DEV_HOME=${WISP_DEV_HOME:-"$HOME/.wisp-dev"}
DEV_PORT=${WISP_DEV_PORT:-18710}
PRODUCTION_HOME=${WISP_PRODUCTION_HOME:-"$HOME/.wisp"}

fail() {
  printf 'wisp-dev: %s\n' "$*" >&2
  exit 1
}

[ -n "$DEV_HOME" ] || fail "WISP_DEV_HOME cannot be empty"
[ "$DEV_HOME" != "/" ] || fail "WISP_DEV_HOME cannot be /"
command -v bun >/dev/null 2>&1 || fail "Bun is required to run Wisp from source"

canonical_path() {
  WISP_PATH=$1 bun -e '
    import { existsSync, realpathSync } from "node:fs";
    import { resolve } from "node:path";
    const path = resolve(process.env.WISP_PATH);
    console.log(existsSync(path) ? realpathSync(path) : path);
  '
}

DEV_HOME=$(canonical_path "$DEV_HOME")
PRODUCTION_HOME=$(canonical_path "$PRODUCTION_HOME")
[ "$DEV_HOME" != "$PRODUCTION_HOME" ] ||
  fail "refusing production home $PRODUCTION_HOME; choose a separate WISP_DEV_HOME"

case "$DEV_PORT" in
  *[!0-9]*|"") fail "WISP_DEV_PORT must be an integer from 1024 to 65535" ;;
esac
[ "$DEV_PORT" -ge 1024 ] && [ "$DEV_PORT" -le 65535 ] ||
  fail "WISP_DEV_PORT must be an integer from 1024 to 65535"

# Ignore any globally exported WISP_HOME. The development command owns this
# process-local boundary before config.ts is loaded.
export WISP_HOME=$DEV_HOME
export WISP_COMMAND_NAME=wisp-dev

command_name=${1:-}
if [ "$command_name" = "serve" ]; then
  # ui-dist is intentionally absent from Git. Keep the direct development
  # daemon command as reliable as `bun run dev:server` on a fresh checkout.
  (cd "$ROOT" && bun run build:ui)
fi
if [ "$command_name" = "init" ]; then
  has_port=no
  for arg in "$@"; do
    [ "$arg" = "--port" ] && has_port=yes
  done
  if [ "$has_port" = no ]; then
    set -- "$@" --port "$DEV_PORT"
  fi
elif [ ! -f "$DEV_HOME/config.json" ]; then
  # Help never creates a home. `brief` answers its help and usage offline
  # (cli-brief-help briefOfflineAnswer) — an agent reads `brief --help` before
  # it has any reason to have a working home — so exactly those forms skip
  # init here too; every other command keeps needing one.
  needs_init=yes
  case "$command_name" in
    ""|help|-h|--help|version|--version) needs_init=no ;;
  esac
  if [ "$command_name" = "brief" ]; then
    brief_sub=${2:-}
    brief_help=no
    brief_stdin=no
    i=0
    for arg in "$@"; do
      i=$((i + 1))
      if [ "$i" -le 2 ]; then continue; fi
      case "$arg" in
        --help|-h|help) brief_help=yes ;;
        --stdin) brief_stdin=yes ;;
      esac
    done
    case "$brief_sub" in
      ""|help|--help|-h) needs_init=no ;;
      set) if [ "$brief_help" = yes ] || [ "$brief_stdin" = no ]; then needs_init=no; fi ;;
      *) if [ "$brief_help" = yes ]; then needs_init=no; fi ;;
    esac
  fi
  if [ "$needs_init" = yes ]; then
    bun "$ROOT/wispd/src/index.ts" init --port "$DEV_PORT" >/dev/null
  fi
fi

exec bun "$ROOT/wispd/src/index.ts" "$@"
