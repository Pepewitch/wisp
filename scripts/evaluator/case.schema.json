{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pepewitch/wisp/blob/main/scripts/evaluator/case.schema.json",
  "title": "Wisp v0.4 evaluator case",
  "type": "object",
  "required": [
    "schemaVersion",
    "case",
    "verdict",
    "baseline",
    "process",
    "oracles",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "case": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["pass", "fail"] },
    "startedAt": { "type": ["string", "null"] },
    "finishedAt": { "type": ["string", "null"] },
    "baseline": { "type": "object" },
    "process": { "type": "object" },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "detail": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
